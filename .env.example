# ── Cerna .env example ────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Required: Groq API key (get one at console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# ── Redis cache (optional) ─────────────────────────────────────────────────────
# App falls back to in-memory LRU if Redis is unreachable — no crash, just slower.
# When using docker compose, leave these at defaults; the compose file sets REDIS_HOST=redis.
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_DB=0

# Cache backend: redis (requires REDIS_HOST reachable) | memory (in-process LRU, default)
# Set to redis to enable persistent query caching across restarts.
# CACHE_BACKEND=redis

# ── Multi-key Groq pool (optional) ────────────────────────────────────────────
# Comma-separated Groq API keys for round-robin quota distribution (Task 2).
# If only one key, uses it directly (same as GROQ_API_KEY).
# GROQ_API_KEYS=key1,key2,key3

# ── Retrieval / embedding settings ────────────────────────────────────────────
# COLLECTION=cerner_docs_bge      # ChromaDB collection (cerner_docs or cerner_docs_bge)
# HYDE_ENABLED=false              # Hypothetical Document Embeddings for vague queries
# RERANK_ENABLED=false            # Cross-encoder reranking (slower but more precise)
# MMR_LAMBDA=0.7                  # Retrieval diversity (0=max diversity, 1=max relevance)

# ── Cache tuning ──────────────────────────────────────────────────────────────
# RESPONSE_CACHE_TTL=3600         # Exact-match cache TTL in seconds (default: 1 hour)
# SEMANTIC_CACHE_THRESHOLD=0.85   # Cosine similarity threshold for semantic cache hit
